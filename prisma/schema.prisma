// ===========================================================================
// Klikado — Prisma schema
//
// Data model for a multi-portal listing SaaS. A user creates a single
// listing and the system publishes it to many classified-ad portals.
//
// Design notes:
//  - Every table that holds user data carries a userId for row-level scoping.
//  - Portal credentials (passwords, cookies, sessions) are stored ENCRYPTED
//    (AES-256-GCM) — see src/lib/crypto.ts. The DB never holds plaintext.
//  - Publication state per (listing, portal) lives in its own table so each
//    portal can fail / succeed independently and carry its own remote IDs.
//  - Jobs and Logs make every async operation observable and retryable.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
  // "native" covers local/Docker; "rhel-openssl-3.0.x" is the runtime on
  // Vercel / AWS Lambda so the deployed app finds a matching query engine.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & users
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String? // default contact phone, pre-filled into new listings
  image         String?
  passwordHash  String? // null when the user only uses OAuth
  role          UserRole  @default(USER)
  blocked       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  subscription        Subscription?
  listings            Listing[]
  portalAccounts      PortalAccount[]
  notifications       Notification[]
  logs                ActivityLog[]
  creditTransactions  CreditTransaction[]

  @@index([role])
}

// NextAuth / Auth.js adapter tables.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Billing / subscriptions
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  BASIC
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   Plan               @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Credit wallet: each publish / topovať costs one credit. The monthly
  // allowance (per plan) is reset on creditsRenewAt. PRO is unlimited and is
  // not decremented. See src/lib/credits.ts.
  credits       Int       @default(30)
  creditsRenewAt DateTime?

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append-only ledger of credit movements (grants and spends) for the user's
// history view and accounting. Negative amount = spent, positive = granted.
model CreditTransaction {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount    Int // negative = spent, positive = granted
  reason    String // "publish" | "topovat" | "monthly_grant" | "signup" | "admin"
  listingId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

enum ListingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Listing {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status ListingStatus @default(DRAFT)

  // Core content
  title       String
  description String  @db.Text
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("EUR")
  category    String
  // Free-form, category-specific parameters (e.g. { "rooms": 3, "area": 75 }).
  parameters  Json     @default("{}")
  tags        String[] @default([])

  // Location
  location String?
  zip      String?

  // Contact
  contactName  String?
  phone        String?
  contactEmail String?
  web          String?

  // Auto-renewal (bump) cadence in hours; null = disabled.
  renewIntervalHours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       ListingImage[]
  publications Publication[]
  logs         ActivityLog[]

  @@index([userId, status])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Object-storage keys for the processed renditions.
  key       String // original (post-processing) object key
  thumbKey  String? // small thumbnail key
  url       String // public URL of the main rendition
  width     Int?
  height    Int?
  bytes     Int?
  mimeType  String  @default("image/webp")
  position  Int     @default(0) // ordering; 0 = main photo
  isMain    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([listingId, position])
}

// ---------------------------------------------------------------------------
// Portals & per-user portal accounts
// ---------------------------------------------------------------------------

enum IntegrationType {
  API // official / reverse-engineered HTTP API
  BROWSER // Playwright browser automation
}

// Catalogue of supported portals. Seeded from the provider registry so the
// admin panel can enable/disable portals without a code change.
model Portal {
  id          String          @id @default(cuid())
  // Stable key matching the provider module, e.g. "bazos-sk".
  key         String          @unique
  name        String
  country     String          @default("SK")
  integration IntegrationType @default(BROWSER)
  enabled     Boolean         @default(true)
  // Whether this portal supports a "bump"/refresh action.
  supportsRefresh Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     PortalAccount[]
  publications Publication[]
}

// A user's login to a specific portal. Secrets are encrypted at rest.
model PortalAccount {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalId String
  portal   Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  label    String? // user-friendly name, e.g. "My personal Bazoš"
  login    String? // username / email on the portal
  // Phone used for portal SMS verification (your phone, receives the code).
  // May differ from the contact phone shown in the ad. Falls back to the
  // listing's phone when empty.
  verifyPhone String?

  // Encrypted blobs (AES-256-GCM, base64). Never returned to the client.
  passwordEnc String? @db.Text
  cookiesEnc  String? @db.Text // serialized Playwright storage state
  sessionEnc  String? @db.Text // provider-specific session/token blob

  // Operational state of the stored session.
  sessionValidUntil DateTime?
  lastLoginAt       DateTime?
  needsReauth       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publications Publication[]

  @@unique([userId, portalId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Publications (per listing × per portal) + jobs + logs
// ---------------------------------------------------------------------------

enum PublicationStatus {
  PENDING // queued, not yet processed
  PUBLISHING // worker is acting on it
  WAITING_SMS // paused: the portal needs an SMS/verification code from the user
  PUBLISHED // live on the portal
  ERROR // failed; see lastError / logs
  UPDATING
  REMOVING
  REMOVED
}

model Publication {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  portalId  String
  portal    Portal  @relation(fields: [portalId], references: [id], onDelete: Cascade)

  // The portal account used to publish (a user may have several per portal).
  portalAccountId String?
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id], onDelete: SetNull)

  status PublicationStatus @default(PENDING)

  remoteId    String? // listing ID assigned by the portal
  remoteUrl   String? // public URL of the published listing
  publishedAt DateTime? // when the CURRENT live ad was posted (resets on repost)
  lastSyncedAt DateTime?
  lastRefreshedAt DateTime?
  nextRefreshAt   DateTime? // when the auto-bump should next run

  // View tracking. Bazoš resets views when an ad is re-posted (topovať), so we
  // keep a cumulative figure: total reach = viewsBase + viewsCurrent.
  viewsCurrent Int @default(0) // views on the current live ad
  viewsBase    Int @default(0) // summed views of all previous (reposted) ads
  viewsCheckedAt DateTime? // last time we scraped the view count

  lastError String? @db.Text
  attempts  Int     @default(0)

  // Soft note about the last status check when it could NOT be confirmed (e.g.
  // not logged in to the portal account, so "Moje inzeráty" isn't visible).
  // Surfaced in the UI as a "neoverené" hint; cleared on a confident check.
  statusNote String? @db.Text

  // Human-in-the-loop verification (e.g. Bazoš SMS code). When the worker
  // pauses for input it sets status=WAITING_SMS + smsPrompt; the user submits
  // the code into smsCode and the worker resumes.
  smsPrompt String?
  smsCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@unique([listingId, portalId])
  @@index([status])
  @@index([nextRefreshAt])
}

enum JobType {
  PUBLISH
  UPDATE
  REFRESH
  DELETE
  CHECK_STATUS
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// Mirror of a BullMQ job for durability / admin visibility. BullMQ owns the
// live queue; this table is the persistent audit record.
model Job {
  id            String  @id @default(cuid())
  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  type      JobType
  status    JobStatus @default(QUEUED)
  bullJobId String? // id within BullMQ
  attempts  Int       @default(0)
  error     String?   @db.Text

  scheduledFor DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([publicationId])
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// Human-readable operation log shown in the UI (e.g. "09:12 Published",
// "09:15 CAPTCHA error"). Distinct from Job, which tracks queue mechanics.
model ActivityLog {
  id        String @id @default(cuid())
  userId    String?
  user      User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  portalKey String?
  level     LogLevel @default(INFO)
  message   String
  meta      Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([listingId, createdAt])
}

// ---------------------------------------------------------------------------
// Image blobs (zero-config storage fallback)
//
// When no S3-compatible storage is configured, processed image renditions are
// stored here and served via /api/blob/<key>. This lets image upload work out
// of the box on a single-service deploy; configure S3/R2 for production scale.
// ---------------------------------------------------------------------------

model ImageBlob {
  key         String   @id
  data        Bytes
  contentType String   @default("image/webp")
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  PUBLISH_DONE
  PUBLISH_ERROR
  SUBSCRIPTION_ENDING
  SYSTEM
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  body    String?          @db.Text
  read    Boolean          @default(false)
  emailed Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}
