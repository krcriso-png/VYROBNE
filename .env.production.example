# ===========================================================================
# Klikado – production env for the VPS (docker-compose.prod.yml).
# Copy to ".env" on the server and fill in the values.
#
# Generate the secrets on the server with:
#   openssl rand -base64 36     # -> AUTH_SECRET
#   openssl rand -hex 32        # -> ENCRYPTION_KEY
#   openssl rand -hex 16        # -> POSTGRES_PASSWORD
# Keep these SECRET and STABLE (changing ENCRYPTION_KEY makes stored portal
# passwords unreadable).
# ===========================================================================

# --- Your domain (drives HTTPS + login) ---
DOMAIN=klikado.sk
AUTH_URL=https://klikado.sk
AUTH_TRUST_HOST=true

# --- Secrets (generate with the commands above) ---
AUTH_SECRET=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME

# --- Portals enabled for browser automation ---
# bazar-sk is always on; add the ones you want to run here.
ENABLE_PORTALS=mock,bazos-sk,bazos-cz

# --- Google sign-in (optional; leave blank to hide the Google button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail notifications (optional; leave blank to skip real e-mails) ---
ADMIN_EMAIL=krcriso@gmail.com
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
