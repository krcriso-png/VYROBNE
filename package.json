    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.21.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "next": "^15.0.3",
    "next-auth": "5.0.0-beta.25",
    "playwright": "^1.48.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "stripe": "^17.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
