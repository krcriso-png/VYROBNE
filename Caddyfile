# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# The domain comes from the DOMAIN env var (set in .env). Caddy obtains and
# renews the TLS certificate on its own — as long as the domain's DNS points to
# this server and ports 80/443 are open.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}
